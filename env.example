# Dashboard Login
NEXT_PUBLIC_PASSWORD=your_secure_password_here

# Meta API
META_ACCESS_TOKEN=EAAW...your_meta_token_here

# Shopify API
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your_shopify_client_id_here

# Stripe — eigen checkout (checkout.getjustjenny.com) + Just Jenny Health For Life Membership
# Prijzen/producten worden automatisch aangemaakt bij de eerste bestelling.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...          # Stripe → Webhooks → endpoint /api/stripe/webhook, event invoice.paid
# STRIPE_PRICE_MEMBERSHIP=price_...      # optioneel: eigen membership-prijs i.p.v. de automatische

# PayPal — rechtstreeks (niet via Stripe). developer.paypal.com → Apps & Credentials → je app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox                       # "sandbox" om te testen, "live" voor echte betalingen
PAYPAL_WEBHOOK_ID=                       # webhook → /api/paypal/webhook, event BILLING.SUBSCRIPTION.ACTIVATED

# Meta (optioneel) — pixel + Conversions API op de checkout
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Post-purchase quiz (bedankpagina) → Google Sheet. ID = het stuk tussen /d/ en /edit in de Sheet-URL.
# Deel de Sheet met GOOGLE_SA_EMAIL als Editor en zet de Google Sheets API aan.
QUIZ_SHEET_ID=
